{
  "name": "@pipelinescore/cli",
  "version": "0.4.1",
  "description": "PipelineScore CLI \u2014 benchmark LLMs on your own hardware. Zero-config: `npx @pipelinescore/cli` auto-detects Ollama / LM Studio / llama.cpp / MLX and walks you through a run. Fully deterministic suite (no API key required), scored locally, published to the hardware-aware public leaderboard at pipelinescore.ai.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ps-bench": "./dist/index.js",
    "pipelinescore": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && node scripts/copy-benchmarks.mjs",
    "test": "tsx test/util.test.ts && tsx test/hardware.test.ts && tsx test/normalize.test.ts && tsx test/score-v2.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "llm",
    "benchmark",
    "leaderboard",
    "local-llm",
    "ollama",
    "lm-studio",
    "mlx",
    "llama-cpp",
    "vllm",
    "ai-evaluation",
    "anthropic",
    "openai",
    "hardware-comparison",
    "local-first",
    "cli"
  ],
  "author": "Drew Mattie <drew.mattie@gmail.com> (https://github.com/drewmattie-code)",
  "license": "Apache-2.0",
  "homepage": "https://pipelinescore.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewmattie-code/pipelinescore.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/drewmattie-code/pipelinescore/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
